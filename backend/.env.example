# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/madsugu
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=madsugu

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API
API_V1_STR=/api/v1
PROJECT_NAME=MadSugu
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# Redis
REDIS_URL=redis://localhost:6379/0

# Mobile Money (placeholder for future integration)
ORANGE_MONEY_API_KEY=
MTN_MONEY_API_KEY=
MOOV_MONEY_API_KEY=

# Email (placeholder for future integration)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@madsugu.com
